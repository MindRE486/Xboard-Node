# Xboard Node Configuration
# Top-level settings are inherited by all instances. Instance overrides take precedence.

# ── Single node (simplest) ──
# panel:
#   url: "https://panel.example.com"
#   token: "your-api-key"
#   node_id: 1
#   node_type: "hiddify"

# ── Multiple instances ──
# kernel:
#   type: "singbox"
# log:
#   level: "info"
# instances:
#   - panel:
#       url: "https://panel.example.com"
#       token: "api-key-1"
#       node_id: 1
#   - panel:
#       url: "https://panel.example.com"
#     machine:
#       machine_id: 2
#       token: "machine-token-2"
#     log:
#       level: "debug"   # override for this instance only

# ── Camouflage site (optional) ──
# Serves a decoy website to TLS probes that are not valid proxy handshakes.
# Supported nodes: xray + TLS + TCP + VLESS/Trojan. No extra public port is
# opened and the panel does not need to know about it.
# camouflage:
#   enabled: true
#   template: 0            # 0 = random, 1-9 = v2ray-agent template
#   # site_dir: /srv/www   # existing site root; index.html here is never replaced
#   # template_base_url: https://raw.githubusercontent.com/mack-a/v2ray-agent/master/fodder/blog/unable
